<div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column;">
  <h1>ログイン</h1>

  <%= form_with url: login_path, method: :post, style: "max-width: 300px; width: 100%;" do |f| %>
    <div style="margin-bottom: 10px;">
      <%= f.label :password, "パスワード", style: "display: block; margin-bottom: 5px;" %>
      <%= f.password_field :password, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" %>
    </div>
    <%= f.submit "ログイン", style: "width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
  <% end %>

  <% if flash[:alert] %>
    <p style="color: red; margin-top: 10px;"><%= flash[:alert] %></p>
  <% end %>
</div>