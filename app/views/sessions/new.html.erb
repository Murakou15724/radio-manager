<div class="login-screen">
  <div class="login-card">
    <div class="login-brand">
      <span class="brand-mark login-brand-mark">📻</span>
      <h1>RADIO<span class="brand-name-accent">MANAGER</span></h1>
    </div>

    <div class="equalizer login-equalizer" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <p class="login-copy">お気に入りのラジオ番組を、聴き逃さない。</p>

    <%= form_with url: login_path, method: :post, class: "login-form" do %>
      <%= submit_tag "ログイン", class: "primary-button submit-button" %>
    <% end %>
  </div>
</div>
