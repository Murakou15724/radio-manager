<div class="page-intro">
  <p class="page-eyebrow">📋 ライブラリ</p>
  <h1 class="page-title">すべての番組</h1>
  <p class="page-subtitle">登録済みの番組一覧</p>
</div>

<% if @programs.any? %>
  <section class="filter-bar" data-controller="filter">
    <div class="filter-search">
      <span class="filter-search-icon">🔍</span>
      <input
        type="text"
        class="filter-search-input"
        placeholder="番組名で検索"
        data-filter-target="input"
        data-action="input->filter#search"
      >
    </div>

    <div class="filter-chips">
      <button type="button" class="chip active" data-frequency="all" data-filter-target="chip" data-action="click->filter#filterByChip">すべて</button>
      <button type="button" class="chip" data-frequency="weekly" data-filter-target="chip" data-action="click->filter#filterByChip">毎週</button>
      <button type="button" class="chip" data-frequency="biweekly" data-filter-target="chip" data-action="click->filter#filterByChip">隔週</button>
      <button type="button" class="chip" data-frequency="monthly" data-filter-target="chip" data-action="click->filter#filterByChip">月1</button>
    </div>

    <section class="program-section">
      <div class="section-header">
        <h2>登録されている番組</h2>
        <span class="section-count"><%= @programs.count %></span>
      </div>

      <ul class="program-grid">
        <% @programs.each do |program| %>
          <%= render "program_row", program: program, filterable: true %>
        <% end %>
      </ul>
      <p class="filter-empty is-hidden" data-filter-target="empty">🔍 一致する番組が見つかりません</p>
    </section>
  </section>
<% else %>
  <section class="empty-section">
    <div class="empty-illustration">📻</div>
    <h2>まだ番組が登録されていません</h2>
    <p>メインページから番組を追加しましょう</p>
    <%= link_to "メインページへ", root_path, class: "primary-button action-button" %>
  </section>
<% end %>
