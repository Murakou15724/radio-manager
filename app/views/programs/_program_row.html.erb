<li
  class="program-card program-row <%= 'listened' if program.listened %>"
  data-name="<%= program.name %>"
  data-frequency="<%= program.frequency_type %>"
  <%= "data-filter-target=\"card\"".html_safe if local_assigns[:filterable] %>
>
  <div class="program-card-ring">
    <svg class="progress-ring" viewBox="0 0 44 44">
      <circle class="progress-ring-track" cx="22" cy="22" r="18"></circle>
      <% ratio = program.cycle_progress_ratio %>
      <% if ratio %>
        <% circumference = (2 * Math::PI * 18).round(2) %>
        <circle
          class="progress-ring-fill <%= program.remaining_days_css_class %>"
          cx="22" cy="22" r="18"
          transform="rotate(-90 22 22)"
          style="stroke-dasharray: <%= circumference %>; stroke-dashoffset: <%= (circumference * (1 - ratio)).round(2) %>;"
        ></circle>
      <% end %>
    </svg>
    <div class="progress-ring-label">
      <span class="progress-ring-label-status"><%= program.listened ? "✓" : "◯" %></span>
    </div>
  </div>

  <div class="program-card-body">
    <div class="program-card-header">
      <strong class="program-card-name"><%= program.name %></strong>
    </div>

    <div class="program-details">
      <div class="detail-item">
        <span class="detail-label">頻度</span>
        <span class="detail-value"><%= program.frequency_label %></span>
      </div>
      <div class="detail-item">
        <span class="detail-label">曜日</span>
        <span class="detail-value"><%= program.weekday_label || "-" %></span>
      </div>
      <% if program.base_date.present? %>
        <div class="detail-item">
          <span class="detail-label">基準日</span>
          <span class="detail-value"><%= program.base_date.strftime("%m/%d") %></span>
        </div>
      <% end %>
      <% if program.week_of_month.present? %>
        <div class="detail-item">
          <span class="detail-label">第何週</span>
          <span class="detail-value">第<%= program.week_of_month %>週</span>
        </div>
      <% end %>
    </div>

    <div class="program-actions">
      <%= link_to "編集", edit_program_path(program), class: "ghost-button" %>
      <%= button_to "削除", program_path(program), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "ghost-button ghost-button-danger" %>
    </div>
  </div>
</li>
