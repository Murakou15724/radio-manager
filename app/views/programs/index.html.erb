<div class="page-intro">
  <p class="page-eyebrow" data-controller="clock">
    <span data-clock-target="date">----年--月--日</span>
  </p>
  <h1 class="page-title">今日のラジオ</h1>
  <p class="page-subtitle">次に聴く番組をチェックしよう</p>
</div>

<section class="quick-add" data-controller="disclosure">
  <button type="button" class="quick-add-toggle" data-action="click->disclosure#toggle">
    <span class="quick-add-toggle-icon">+</span>
    <span data-disclosure-target="toggleLabel">番組を追加</span>
  </button>

  <div class="quick-add-panel" data-disclosure-target="panel">
    <%= form_with model: @program, local: true, class: "program-form" do |f| %>
      <div class="form-group">
        <%= f.label :name, "番組名" %>
        <%= f.text_field :name, placeholder: "番組名を入力" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :frequency_type, "頻度" %>
          <%= f.select :frequency_type, [["毎週", "weekly"], ["隔週", "biweekly"], ["月1", "monthly"]] %>
        </div>

        <div class="form-group">
          <%= f.label :weekday, "曜日" %>
          <%= f.select :weekday, Program.weekday_options, include_blank: "選択してください" %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :week_of_month, "第何週（月1用）" %>
          <%= f.select :week_of_month, [["第1週", 1], ["第2週", 2], ["第3週", 3], ["第4週", 4], ["第5週", 5]] %>
        </div>

        <div class="form-group">
          <%= f.label :base_date, "基準日（隔週用）" %>
          <%= f.date_field :base_date %>
        </div>
      </div>

      <%= f.submit "追加する", class: "primary-button submit-button" %>
    <% end %>
  </div>
</section>

<section class="filter-bar" data-controller="filter">
  <div class="filter-search">
    <span class="filter-search-icon">🔍</span>
    <input
      type="text"
      class="filter-search-input"
      placeholder="番組名で検索"
      data-filter-target="input"
      data-action="input->filter#search"
    >
  </div>

  <div class="filter-chips">
    <button type="button" class="chip active" data-frequency="all" data-filter-target="chip" data-action="click->filter#filterByChip">すべて</button>
    <button type="button" class="chip" data-frequency="weekly" data-filter-target="chip" data-action="click->filter#filterByChip">毎週</button>
    <button type="button" class="chip" data-frequency="biweekly" data-filter-target="chip" data-action="click->filter#filterByChip">隔週</button>
    <button type="button" class="chip" data-frequency="monthly" data-filter-target="chip" data-action="click->filter#filterByChip">月1</button>
  </div>

  <section class="program-section">
    <div class="section-header">
      <h2>未聴取の番組</h2>
      <span class="section-count"><%= @unlistened_programs.count %></span>
    </div>

    <% if @unlistened_programs.any? %>
      <ul class="program-grid">
        <% @unlistened_programs.each do |program| %>
          <%= render "program_card", program: program, filterable: true %>
        <% end %>
      </ul>
      <p class="filter-empty is-hidden" data-filter-target="empty">🔍 一致する番組が見つかりません</p>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✓</div>
        <p>すべて聴き取りました！</p>
      </div>
    <% end %>
  </section>
</section>

<details class="collapsible-listened">
  <summary>
    <div>
      <h2>聴取済みの番組</h2>
      <span class="summary-count"><%= @listened_programs.count %></span>
    </div>
    <span class="chevron">›</span>
  </summary>
  <div class="panel">
    <% if @listened_programs.any? %>
      <ul class="program-grid">
        <% @listened_programs.each do |program| %>
          <%= render "program_card", program: program %>
        <% end %>
      </ul>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">🎵</div>
        <p>聴取済みの番組はまだありません</p>
      </div>
    <% end %>
  </div>
</details>
